   "end": 8.54
  },
  {
   "scene": "smash",
   "who": "you",
   "text": "Wait. What?",
   "start": 8.89,
   "end": 10.41
  },
  {
   "scene": "bed",
   "who": "narrator",
   "text": "You sit up. The bed frame snaps like a breadstick.",
   "start": 11.11,
   "end": 14.47
  },
  {
   "scene": "bed",
   "who": "roommate",
   "text": "What was that?!",
